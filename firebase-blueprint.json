{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "E-commerce store item in Jihan Store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "titleBn": { "type": "string", "maxLength": 200 },
        "price": { "type": "number" },
        "discountPrice": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "image": { "type": "string", "maxLength": 1000 },
        "images": { "type": "array" },
        "stock": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "badge": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 5000 },
        "sku": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "price", "category", "stock"]
    },
    "Category": {
      "title": "Category",
      "description": "Product classification category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "nameBn": { "type": "string", "maxLength": 100 },
        "icon": { "type": "string", "maxLength": 100 },
        "image": { "type": "string", "maxLength": 1000 },
        "itemCount": { "type": "number" }
      },
      "required": ["name", "icon"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 200 },
        "customerName": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 100 },
        "note": { "type": "string", "maxLength": 500 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cod", "wallet", "bkash", "nagad"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "refunded"] },
        "trxId": { "type": "string", "maxLength": 100 },
        "orderStatus": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["customerName", "phone", "address", "items", "totalAmount", "paymentMethod", "orderStatus"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with wallet balance and address",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 100 },
        "walletBalance": { "type": "number" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Wallet deposit, withdrawal, or payment transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userName": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["deposit", "withdraw", "payment", "refund"] },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["bkash", "nagad", "rocket", "bank", "wallet_deduct"] },
        "senderNumber": { "type": "string", "maxLength": 50 },
        "trxId": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "type", "amount", "method", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount voucher",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 50 },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "discountValue": { "type": "number" },
        "minOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "expiryDate": { "type": "string" },
        "usageCount": { "type": "number" }
      },
      "required": ["code", "discountType", "discountValue", "isActive"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store configuration and contact details",
      "type": "object",
      "properties": {
        "storeName": { "type": "string", "maxLength": 100 },
        "storeSlogan": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 500 },
        "insideDhakaDelivery": { "type": "number" },
        "outsideDhakaDelivery": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" },
        "announcement": { "type": "string", "maxLength": 500 },
        "bkashNumber": { "type": "string", "maxLength": 50 },
        "nagadNumber": { "type": "string", "maxLength": 50 },
        "facebookUrl": { "type": "string", "maxLength": 500 },
        "youtubeUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["storeName"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer testimonial and review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 1000 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "isVerifiedPurchase": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userName", "rating", "comment"]
    },
    "AdminDoc": {
      "title": "AdminDoc",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products catalog items"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and wallet balance"
    },
    "/wallet_transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "User wallet deposit, withdrawal, and payment logs"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Discount coupon codes"
    },
    "/store_settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Store settings and contact information"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer reviews and testimonials"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminDoc" },
      "description": "Authorized administrators list"
    }
  }
}
