rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'jihanstoreofficial009@gmail.com' ||
        request.auth.token.email.lower() == 'jihanstore009@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection health check
    match /test/{docId} {
      allow read: if true;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Store settings and banners
    match /store_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Advertisements (Store Promos & 3rd Party Ads)
    match /ads/{adId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'views', 'updatedAt'])
      );
    }

    // Reviews & Testimonials
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || 
                      (!isSignedIn() && request.resource.data.rating >= 1 && request.resource.data.rating <= 5);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Orders
    match /orders/{orderId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || !isSignedIn();
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || 
                      (!isSignedIn() && request.resource.data.totalAmount > 0);
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.orderStatus == 'cancelled' && resource.data.orderStatus == 'pending')
      );
      allow delete: if isAdmin();
    }

    // User profiles & wallet balance
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Wallet Transactions
    match /wallet_transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin records
    match /admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && (
        request.auth.token.email.lower() == 'jihanstoreofficial009@gmail.com' ||
        request.auth.token.email.lower() == 'jihanstore009@gmail.com'
      ));
    }
  }
}
